NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# --- Fournisseur IA (optionnel) -------------------------------------------
# AI_PROVIDER : openai (defaut) | anthropic | zai | openrouter
# OpenRouter (OpenAI-compatible) : reutilise OPENAI_API_KEY = cle OpenRouter (sk-or-...)
#   AI_PROVIDER=openrouter
#   OPENAI_MODEL=z-ai/glm-4.6        # slug exact du modele sur OpenRouter
#   OPENAI_BASE_URL=                 # laisser VIDE (defaut https://openrouter.ai/api/v1)
#   OPENROUTER_SITE_URL=https://autofunnel.ai   # optionnel (attribution)
#   OPENROUTER_APP_NAME=AutoFunnel AI            # optionnel (attribution)
#   OPENAI_MAX_TOKENS=8000           # optionnel (GLM supporte bien plus)
#   OPENROUTER_REASONING=disabled    # défaut: thinking désactivé (vitesse). low|medium|high|default
#   AI_TIMEOUT_MS=75000              # timeout page principale (relever si modèle lent)
#   AI_PAGE_TIMEOUT_MS=60000         # timeout par page secondaire
#   OPENROUTER_PROVIDER_SORT=throughput  # défaut: provider le plus rapide. latency|price|off
# --- Stockage des medias : CLOUDINARY --------------------------------------
# Depuis la migration du 3 aout 2026, les images et videos ne sont PLUS
# stockees dans Supabase Storage (bucket sature a 149 % du quota du plan Free).
# Elles partent chez Cloudinary, qui sert aussi la livraison optimisee
# (f_auto,q_auto : WebP/AVIF selon le navigateur).
#
# 🔒 SERVEUR UNIQUEMENT. API_SECRET signe les requetes : exposee cote client,
# elle permettrait d'uploader ET de supprimer sur le compte. Ne jamais la
# prefixer NEXT_PUBLIC_.
#
# A renseigner dans .env.local ET dans les variables d'environnement Vercel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
RESEND_FROM=AutoFunnel AI <hello@yourdomain.com>
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
